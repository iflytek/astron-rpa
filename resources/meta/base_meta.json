  "Code.ForList": {
    "key": "Code.ForList",
    "title": "列表For循环",
    "version": "1",
    "comment": "在列表 @{list} 中通过循环变量 @{item} 遍历列表，进行循环操作，输出列表循环至 @{item} , 输出循环项位置为 @{index} ",
    "inputList": [
      {
        "types": "List",
        "formType": {
          "type": "INPUT_VARIABLE_PYTHON"
        },
        "key": "list",
        "title": "列表对象",
        "name": "list",
        "tip": "循环中遍历的列表，可自行创建或引用前面组件已创建的列表",
        "default": ""
      }
    ],
    "outputList": [
      {
        "types": "Int",
        "formType": {
          "type": "RESULT"
        },
        "key": "index",
        "title": "循环项位置",
        "tip": "默认变量可修改，用于遍历列表的变量索引数值",
        "required": true
      },
      {
        "types": "Any",
        "formType": {
          "type": "RESULT"
        },
        "key": "item",
        "title": "循环项",
        "tip": "默认变量可修改，用于遍历列表的变量",
        "required": true
      }
    ],
    "icon": "list-for-loop",
    "helpManual": "",
    "noAdvanced": true
  },

      "position_x": {
        "title": "鼠标x位置"
      },
      "position_y": {
        "title": "鼠标y位置"
      },
      "move_type": {
        "title": "鼠标移动方式",
        "tip": "选择鼠标移动方式"
      },
      "move_speed": {
        "title": "鼠标移动速度"
      }
    }
  },
  "Gui.keyboard": {
    "title": "键盘输入",
    "comment": "通过@{keyboard_type}方式模拟键盘输入@{message}",
    "inputList": {
      "keyboard_type": {
        "title": "输入方式",
        "tip": "普通输入：windows键盘消息的方式来模拟按键输入；剪切板输入：获取剪切板内容并粘贴输入；按键组合：使用插入键盘符号组合快捷输入；驱动输入：使用驱动来模拟按键输入，一般用于网银密码框输入场景或其它普通输入方式无法输入的场景"
      },
      "message": {
        "title": "输入内容"
      },
      "simulate_flag": {
        "title": "模拟人工输入",
        "tip": "模拟人工方式操作键盘逐个输入字符，默认为否"
      },
      "interval": {
        "title": "输入间隔",
        "tip": "设置输入间隔，单位为秒"
      }
    }
  },
  "Gui.key_input": {
    "title": "键盘模拟按键",

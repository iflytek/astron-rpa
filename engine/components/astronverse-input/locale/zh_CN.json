    "inputList": {
      "window_type": {
        "title": "窗口类型",
        "tip": "整个屏幕：以屏幕左上角为坐标相对位置；激活窗口：以激活窗口左上角为相对坐标位置"
      },
      "window_position": {
        "title": "窗口左上角位置"
      },
      "get_mouse_position": {
        "title": "获取鼠标位置"

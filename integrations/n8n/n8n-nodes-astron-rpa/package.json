{
  "name": "@iflytekopensource/n8n-nodes-astron-rpa",
  "version": "0.1.0",
  "description": "Astron-RPA for n8n: automate JSON data, browser and service reads, Office and files, Windows desktop tasks, and approved AI/code workflows through MCP.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iflytek/astron-rpa.git",
    "directory": "integrations/n8n/n8n-nodes-astron-rpa"
  },
  "homepage": "https://github.com/iflytek/astron-rpa/tree/main/integrations/n8n/n8n-nodes-astron-rpa#readme",
  "bugs": {
    "url": "https://github.com/iflytek/astron-rpa/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "Astron-RPA",
    "rpa",
    "robotic-process-automation",
    "workflow-automation",
    "browser-automation",
    "office-automation",
    "desktop-automation",
    "data-processing",
    "ai-automation",
    "mcp",
    "n8n",
    "n8n-community-node-package"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist/**/*.js",
    "dist/package.json",
    "examples/desktop-ui.json",
    "examples/execute-and-query.json",
    "examples/office-file.json",
    "examples/README.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:package": "npm run build && node tests/package.cjs",
    "release:check": "npm run typecheck && npm run lint && npm run format:check -- --end-of-line auto && npm test && npm audit --omit=dev --audit-level=moderate && npm run test:package && npm audit --include=dev --audit-level=moderate",
    "prepack": "npm run build"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/AstronRpaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/AstronRpa/AstronRpa.node.js"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "bundleDependencies": [
    "@modelcontextprotocol/sdk"
  ],
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "zod": "4.6.7"
    },
    "n8n-workflow": {
      "axios": "1.20.0"
    }
  },
  "peerDependencies": {
    "n8n-workflow": ">=2.36.4 <3"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "eslint": "9.39.1",
    "n8n-workflow": "2.36.4",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1"
  }
}
